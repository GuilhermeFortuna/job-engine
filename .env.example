POSTGRES_DB=job_engine
POSTGRES_USER=job_engine
POSTGRES_PASSWORD=job_engine
POSTGRES_PORT=5432
DATABASE_URL=postgresql://job_engine:job_engine@127.0.0.1:5432/job_engine
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
JOB_ENGINE_RESUME_ROOT=docs/resume
# Required. The API refuses to start with fewer than 32 characters.
# Generate your own before first run:  openssl rand -hex 32
JOB_ENGINE_RUNNER_SECRET=replace-me-with-openssl-rand-hex-32-output
JOB_ENGINE_FRONTEND_ORIGIN=http://localhost:3000
JOB_ENGINE_WEB_ORIGIN=http://127.0.0.1:3000
JOB_ENGINE_API_BASE_URL=http://127.0.0.1:8001
JOB_ENGINE_DESKTOP_USER_DATA_DIR=
JOB_ENGINE_EVIDENCE_ROOT=~/.job-engine/evidence
# Answer provider: deterministic (default), local (loopback-only development), or gemini (cloud)
JOB_ENGINE_ANSWER_PROVIDER=deterministic
JOB_ENGINE_LOCAL_PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
JOB_ENGINE_LOCAL_MODEL=
JOB_ENGINE_GEMINI_MODEL=gemini-2.5-flash
JOB_ENGINE_PROVIDER_PRIVACY_ATTESTATION_ID=
JOB_ENGINE_GEMINI_API_KEY=

